---
import Todo from "./Todo.astro";
import { todoText } from "../lib/todo";
import type { SiteData } from "../lib/types";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const mailHref = `mailto:${todoText(data.contact.email)}`;
---

<section class="sec contact" id="contact">
  <div class="in">
    <div class="contact-box">
      <h2>{data.contact.heading}</h2>
      <div class="mail-box">
        <p class="mail"><a href={mailHref}><Todo value={data.contact.email} /></a></p>
        <a class="btn p" href={mailHref}>{data.contact.cta} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
