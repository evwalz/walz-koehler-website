---
import Layout from "../layouts/Layout.astro";
import Todo from "./Todo.astro";
import { todoText } from "../lib/todo";
import type { SiteData } from "../lib/types";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const p = data.privacy;
---

<Layout page="privacy" data={data} meta={data.meta.privacy}>
  <div class="in sec legal">
    <h1>{p.heading}</h1>
    <p><mark class="pend">{todoText(p.checkNotice)}</mark></p>
    {p.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.intro && <p>{section.intro}</p>}
        <p><Todo value={section.body} /></p>
      </section>
    ))}
  </div>
</Layout>
