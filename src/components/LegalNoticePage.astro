---
import Layout from "../layouts/Layout.astro";
import Todo from "./Todo.astro";
import { todoText } from "../lib/todo";
import type { SiteData } from "../lib/types";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const n = data.legalNotice;
---

<Layout page="legalNotice" data={data} meta={data.meta.legalNotice}>
  <div class="in sec legal">
    <h1>{n.heading}</h1>
    <p><mark class="pend">{todoText(n.checkNotice)}</mark></p>
    <section>
      <p>{n.ddgIntro}</p>
      <dl>
        {n.facts.map((fact) => (
          <>
            <dt>{fact.label}</dt>
            <dd><Todo value={fact.value} /></dd>
          </>
        ))}
      </dl>
    </section>
    <section>
      <p>{n.responsibleIntro}</p>
      <p><Todo value={n.responsibleValue} /></p>
    </section>
  </div>
</Layout>
