---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Range from "./Range.astro";
import Principle from "./Principle.astro";
import Work from "./Work.astro";
import HowWeWork from "./HowWeWork.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import type { Lang } from "../lib/routes";
import type { SiteData } from "../lib/types";

interface Props {
  lang: Lang;
  data: SiteData;
}

const { lang, data } = Astro.props;
---

<Layout lang={lang} page="home" data={data} meta={data.meta.home}>
  <Hero data={data} />
  <Services data={data} />
  <Range lang={lang} data={data} />
  <Principle data={data} />
  <Work data={data} />
  <HowWeWork data={data} />
  <About data={data} />
  <Contact data={data} />
</Layout>
