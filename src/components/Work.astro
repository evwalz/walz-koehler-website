---
import Todo from "./Todo.astro";
import { partSearchStripSVG, partSearchStackSVG, B3_COLORS } from "../lib/drawings";
import type { SiteData } from "../lib/types";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const strip = partSearchStripSVG(B3_COLORS);
const stack = partSearchStackSVG(B3_COLORS);
---

<section class="sec" id="work">
  <div class="in">
    <h2>{data.work.heading}</h2>
    <div class="works">
      {data.work.items.map((item) => (
        <article class:list={["card", "work", item.wide && "work-wide", item.pending && "pending"]}>
          {item.drawing === "part-search" && (
            <figure class="work-fig">
              <div class="fig-wide" set:html={strip} />
              <div class="fig-stack" set:html={stack} />
            </figure>
          )}
          <p class="eyebrow">{item.eyebrow}</p>
          <h3><Todo value={item.title} /></h3>
          <p><Todo value={item.text} /></p>
          {item.sources.length > 0 && (
            <div class="srcs">
              {item.sources.map((source) => (
                <a class="src" href={source.href} target="_blank" rel="noopener">
                  {source.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
