---
import type { SiteData } from "../lib/types";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
---

<section class="sec" id="services">
  <div class="in">
    <h2 class="h-tight">{data.services.heading}</h2>
    <p class="svc-lead">{data.services.lead}</p>
    <div class="svc">
      {data.services.items.map((item) => (
        <div class="svc-item">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
