---
import { partSearchStripSVG, partSearchStackSVG, B3_COLORS } from "../lib/drawings";
import type { SiteData } from "../lib/types";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const cs = data.caseStudy;
const strip = partSearchStripSVG(B3_COLORS);
const stack = partSearchStackSVG(B3_COLORS);
---

{cs && (
  <section class="sec cs" id="case">
    <div class="in">
      <p class="eyebrow">{cs.eyebrow}</p>
      <h2 class="h-tight">{cs.heading}</h2>
      <p class="svc-lead">{cs.lede}</p>

      <div class="cs-strip" set:html={strip} />
      <div class="cs-stack" set:html={stack} />

      <ol class="cs-steps">
        {cs.steps.map((step, i) => (
          <li class="cs-step">
            <span class="cs-n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>

      <div class="cs-foot">
        <ul class="cs-facts">
          {cs.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <p class="cs-note">{cs.note}</p>
      </div>
    </div>
  </section>
)}
