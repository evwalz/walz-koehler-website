---
import { ROUTES, type Lang, type PageKind } from "../lib/routes";
import type { SiteData } from "../lib/types";

interface Props {
  lang: Lang;
  page: PageKind;
  data: SiteData;
}

const { lang, page, data } = Astro.props;
const homeHref = ROUTES[lang].home;
const brandHref = page === "home" ? "#top" : homeHref;

// The two languages always sit in the same place: German left, English right. Only the
// highlight moves, so the switch does not make the buttons jump under the pointer.
const LANG_ORDER: Lang[] = ["de", "en"];
const langLabel = (l: Lang) => (l === lang ? data.nav.langCurrentLabel : data.nav.langOtherLabel);

function sectionHref(id: string): string {
  return page === "home" ? `#${id}` : `${homeHref}#${id}`;
}
---

<header class="nav">
  <div class="in nav-in">
    <a class="brand" href={brandHref}>{data.nav.brand}</a>
    <div class="nav-r">
      <nav class="links" aria-label={data.nav.ariaLabel}>
        <a href={sectionHref("work")}>{data.nav.links.work}</a>
        <a href={sectionHref("about")}>{data.nav.links.about}</a>
        <a href={sectionHref("contact")}>{data.nav.links.contact}</a>
      </nav>
      <div class="lang" role="group" aria-label={data.nav.langGroupAriaLabel}>
        {
          LANG_ORDER.map((l) =>
            l === lang ? (
              <span aria-current="page">{langLabel(l)}</span>
            ) : (
              <a href={ROUTES[l][page]} aria-label={data.nav.langOtherAriaLabel}>{langLabel(l)}</a>
            ),
          )
        }
      </div>
    </div>
  </div>
</header>
