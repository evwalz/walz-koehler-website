---
import { ROUTES } from "../lib/routes";
import type { SiteData } from "../lib/types";
import Todo from "./Todo.astro";

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
---

<footer class="foot">
  <div class="in foot-in">
    <span>{data.footer.copyright}</span>
    <a href={ROUTES.legalNotice}>{data.footer.legalNoticeLabel}</a>
    <a href={ROUTES.privacy}>{data.footer.privacyLabel}</a>
    <span><Todo value={data.footer.invoicingNote} /></span>
  </div>
</footer>
