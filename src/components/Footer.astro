---
import { ROUTES, type Lang } from "../lib/routes";
import type { SiteData } from "../lib/types";

interface Props {
  lang: Lang;
  data: SiteData;
}

const { lang, data } = Astro.props;
---

<footer class="foot">
  <div class="in foot-in">
    <span>{data.footer.copyright}</span>
    <a href={ROUTES[lang].legalNotice}>{data.footer.legalNoticeLabel}</a>
    <a href={ROUTES[lang].privacy}>{data.footer.privacyLabel}</a>
  </div>
</footer>
