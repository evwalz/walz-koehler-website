---
import "../styles/fonts.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ROUTES, type PageKind } from "../lib/routes";
import { SITE_URL, LAUNCHED } from "../config/site.mjs";
import type { SiteData } from "../lib/types";

interface Props {
  page: PageKind;
  data: SiteData;
  meta: { title: string; description: string };
}

const { page, data, meta } = Astro.props;
const canonicalUrl = new URL(ROUTES[page], SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={data.nav.brand} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!LAUNCHED && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">{data.skipLink}</a>
    <Nav page={page} data={data} />
    <main id="main">
      <slot />
    </main>
    <Footer data={data} />
    <script>
      // Menu-bar hairline once the page scrolls under it (spec §1). Purely cosmetic:
      // the page renders and works fully with JS disabled.
      function sc() {
        document.documentElement.classList.toggle("scrolled", window.scrollY > 4);
      }
      window.addEventListener("scroll", sc, { passive: true });
      sc();
    </script>
  </body>
</html>
